# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Supabase Credentials
NEXT_PUBLIC_SUPABASE_URL="https://vnoxmoqnyqaqnlsnwbus.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your_supabase_anon_key"
SUPABASE_SERVICE_ROLE_KEY="your_supabase_service_role"

# Prisma Database URLs (Direct Connection & Connection Pooling)
DATABASE_URL="postgresql://user:pass@host:port/dbname?pgbouncer=true"
DIRECT_URL="postgresql://user:pass@host:port/dbname"

# Resend Email API
RESEND_API_KEY="re_your_resend_api_key"

# Demo Account Redirect URL
NEXT_PUBLIC_DEMO_URL="https://demo.zaynahspos.com"

# Admin Contact Info
ADMIN_EMAIL="zaynahspos@gmail.com"
ADMIN_WHATSAPP="+923001234567"
ADMIN_PASSWORD="zaynahsadmin123"
